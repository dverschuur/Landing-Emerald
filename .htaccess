# Apache / cPanel: URLs limpias para la SPA (dominio/home, dominio/about, ...).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Sirve el archivo real si existe (img, js, views, favicons...).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # El resto lo resuelve el router del App Shell.
  RewriteRule ^ index.html [L]
</IfModule>
